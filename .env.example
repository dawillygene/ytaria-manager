# ytaria-manager production configuration. Copy to `.env` (never commit it) and fill in every value.
# Generate secrets with:  openssl rand -hex 32   (hex only: the values are embedded in connection URLs)

# --- Public site -------------------------------------------------------------------------------
YTARIA_DOMAIN=downloads.example.com
# Origins allowed to call the API cross-origin. The Android app's WebView origin is https://localhost.
# The web app is same-origin and needs no entry.
YTARIA_CORS_ORIGINS=https://localhost

# --- Secrets (required) --------------------------------------------------------------------------
YTARIA_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Accounts ------------------------------------------------------------------------------------
# open | invite | closed. Open registration on a public download service is an abuse risk: prefer invite.
YTARIA_REGISTRATION_MODE=invite
YTARIA_REGISTRATION_CODE=

# --- Limits (defaults are conservative starting points; measure before raising, see docs/DEPLOYMENT.md)
YTARIA_MAX_CONCURRENT_JOBS_GLOBAL=2
YTARIA_MAX_CONCURRENT_JOBS_PER_USER=1
YTARIA_MAX_ACTIVE_JOBS_PER_USER=5
YTARIA_USER_QUOTA_BYTES=10737418240
YTARIA_MAX_FILE_BYTES=2147483648
YTARIA_MIN_FREE_DISK_BYTES=2147483648
YTARIA_COMPLETED_RETENTION_HOURS=168
YTARIA_ALLOWED_SOURCE_HOSTS=youtube.com,youtu.be,vimeo.com,dailymotion.com,archive.org

# --- Container resource limits -------------------------------------------------------------------
WORKER_MEM_LIMIT=2g
WORKER_CPUS=2
API_MEM_LIMIT=512m
